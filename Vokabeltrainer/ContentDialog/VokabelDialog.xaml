<Page
    x:Class="Vokabeltrainer.ContentDialog.VokabelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="NeueVokabelDialog">

    <StackPanel Spacing="12" MinWidth="360">
        <TextBox Header="Deutsch" PlaceholderText="Deutsches Wort"
                 Text="{x:Bind Deutsch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="256" IsSpellCheckEnabled="False"
                 AutomationProperties.AutomationId="NeueVokabelDeutsch" />
        <TextBox Header="Englisch" PlaceholderText="Englische Übersetzung"
                 Text="{x:Bind Englisch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="256" IsSpellCheckEnabled="False"
                 AutomationProperties.AutomationId="NeueVokabelEnglisch" />
    </StackPanel>
</Page>
