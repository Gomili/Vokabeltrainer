<Page
    x:Class="Vokabeltrainer.Views.VokabelTrainingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:Vokabeltrainer.Converter"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Vokabeltrainer.DisplayClasses"
    x:Name="TrainingPage"
    AutomationProperties.AutomationId="TrainingSeite">

    <Page.Resources>
        <converter:StringToColorConverter x:Key="StringToColorConverter" />

        <Style x:Key="HeroKennzahlKarte" TargetType="Border">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinWidth" Value="92" />
        </Style>

        <Style x:Key="WertPlakette" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource FluentPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Warum: Die Hero-Fläche bündelt Motivation und Tagesergebnis. Dadurch ist
             der wichtigste Kontext erkennbar, bevor der Benutzer Einstellungen bedient. -->
        <Border Style="{StaticResource FluentAccentCardStyle}"
                AutomationProperties.AutomationId="Tagesstatistik">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#20FFFFFF">
                        <FontIcon Glyph="&#xE82D;" FontSize="25"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Deine Lernrunde"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Ein paar Minuten heute machen morgen den Unterschied."
                                   MaxWidth="330" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource HeroKennzahlKarte}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="GEÜBT" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GesammtAnzahl, Mode=OneWay}"
                                   Style="{StaticResource FluentMetricValueStyle}"
                                   AutomationProperties.AutomationId="HeuteGesamt" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource HeroKennzahlKarte}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="RICHTIG" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GesammtRichtige, Mode=OneWay}"
                                   Style="{StaticResource FluentMetricValueStyle}"
                                   AutomationProperties.AutomationId="HeuteRichtig" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource HeroKennzahlKarte}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="OFFEN" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GesammtFalsche, Mode=OneWay}"
                                   Style="{StaticResource FluentMetricValueStyle}"
                                   AutomationProperties.AutomationId="HeuteFalsch" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Expander Grid.Row="1"
                  IsExpanded="{x:Bind ViewModel.TrainingseinstellungenGeoeffnet, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.AutomationId="TrainingKonfiguration">
            <Expander.Header>
                <Grid MinHeight="52" ColumnSpacing="14" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE823;" FontSize="17"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.TrainingsstatusText, Mode=OneWay}"
                                   FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.TrainingsstatusHinweis, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.LaufendeRundeSichtbarkeit, Mode=OneWay}">
                        <TextBlock Text="LAUFZEIT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Laufzeit, Mode=OneWay}"
                                   FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="Runde auswerten"
                            Command="{x:Bind ViewModel.StopSyncCommand}"
                            Visibility="{x:Bind ViewModel.LaufendeRundeSichtbarkeit, Mode=OneWay}"
                            AutomationProperties.AutomationId="TrainingBeenden" />
                </Grid>
            </Expander.Header>

            <Border Style="{StaticResource FluentCardStyle}" Padding="16,12">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vokabeln pro Runde" Style="{StaticResource FluentFieldLabelStyle}" />
                            <Border Grid.Column="1" Style="{StaticResource WertPlakette}">
                                <TextBlock Text="{x:Bind ViewModel.AnzahlLernVokabeln, Mode=OneWay}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Slider Minimum="1" Maximum="100" TickFrequency="1"
                                Value="{x:Bind ViewModel.AnzahlLernVokabeln, Mode=TwoWay}"
                                StepFrequency="1" SnapsTo="StepValues"
                                AutomationProperties.AutomationId="TrainingsUmfang" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Priorisierte Vokabeln" Style="{StaticResource FluentFieldLabelStyle}" />
                            <Border Grid.Column="1" Style="{StaticResource WertPlakette}">
                                <TextBlock Text="{x:Bind ViewModel.AnzahlPrioVokabeln, Mode=OneWay}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Slider Minimum="0" Maximum="10" TickFrequency="1"
                                Value="{x:Bind ViewModel.AnzahlPrioVokabeln, Mode=TwoWay}"
                                StepFrequency="1" SnapsTo="StepValues"
                                AutomationProperties.AutomationId="PriorisierteVokabeln" />
                        <ToggleSwitch OnContent="Nur neue Vokabeln" OffContent="Bekannte einbeziehen"
                                      IsOn="{x:Bind ViewModel.NurNeueVokabeln, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="NurNeueVokabeln" />
                    </StackPanel>

                    <Button Grid.Column="2" MinWidth="160" Height="46"
                            Command="{x:Bind ViewModel.StartCommand}"
                            IsEnabled="{x:Bind ViewModel.Running, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TrainingStarten">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="15" />
                            <TextBlock Text="Training starten" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Expander>

        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Aktuelle Lernrunde" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Übersetze die Begriffe und werte anschließend die Runde aus."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource WertPlakette}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.Anzahl, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ListView Grid.Row="1" x:Name="VokabelListe"
                          ItemsSource="{x:Bind ViewModel.Lernliste, Mode=OneWay}"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollMode="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.AutomationId="TrainingsVokabelListe"
                          AutomationProperties.Name="Vokabeln des aktuellen Trainings">
                    <ListView.Header>
                        <ct:DataTable Margin="12,8" MinWidth="900">
                            <ct:DataColumn Content="Status" Width="90" />
                            <ct:DataColumn DesiredWidth="230">
                                <TextBlock Text="{x:Bind ViewModel.Vorgabensprache, Mode=OneWay}" />
                            </ct:DataColumn>
                            <ct:DataColumn DesiredWidth="260">
                                <TextBlock Text="{x:Bind ViewModel.Antwortspalte, Mode=OneWay}" />
                            </ct:DataColumn>
                            <ct:DataColumn DesiredWidth="230">
                                <TextBlock Text="Lösung" Margin="12,0,0,0" />
                            </ct:DataColumn>
                            <ct:DataColumn Content="Audio" DesiredWidth="*" />
                        </ct:DataTable>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DisplayLernVokabel">
                            <ct:DataRow MinWidth="900" AutomationProperties.Name="{x:Bind Vorgabe}">
                                <Border Background="{x:Bind Richtig, Mode=OneWay, Converter={StaticResource StringToColorConverter}}"
                                        CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind Richtig, Mode=OneWay}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Bind Vorgabe, Mode=OneWay}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <TextBox Text="{x:Bind Antwort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Übersetzung eingeben"
                                         IsSpellCheckEnabled="False"
                                         AutomationProperties.Name="Antwort" />
                                <TextBlock Text="{x:Bind Loesung, Mode=OneWay}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Command="{x:Bind SpeakCommand}" CommandParameter="{x:Bind}"
                                        IsEnabled="{x:Bind SpeakButtonEnabled, Mode=OneWay}"
                                        ToolTipService.ToolTip="{Binding ElementName=TrainingPage, Path=ViewModel.AudioTooltip}"
                                        AutomationProperties.Name="{Binding ElementName=TrainingPage, Path=ViewModel.AudioTooltip}">
                                    <SymbolIcon Symbol="Volume" />
                                </Button>
                            </ct:DataRow>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
