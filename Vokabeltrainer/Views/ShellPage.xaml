<Page
    x:Class="Vokabeltrainer.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Vokabeltrainer.Behaviors"
    xmlns:helpers="using:Vokabeltrainer.Helpers"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    AutomationProperties.AutomationId="AppShell">

    <Page.Resources>
        <Style x:Key="SeitenleistenEintrag" TargetType="NavigationViewItem">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid x:Name="AppTitleBar"
              Canvas.ZIndex="1"
              Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
              IsHitTestVisible="True"
              VerticalAlignment="Top">
            <Image Source="/Assets/WindowIcon.ico"
                   HorizontalAlignment="Left"
                   Width="16"
                   Height="16"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="AppTitleBarText"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Margin="28,0,0,0" />
        </Grid>

        <NavigationView
            x:Name="NavigationViewControl"
            Canvas.ZIndex="0"
            OpenPaneLength="272"
            CompactPaneLength="48"
            IsPaneOpen="True"
            IsBackButtonVisible="Visible"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionFollowsFocus="Disabled"
            ExpandedModeThresholdWidth="1100"
            PaneOpening="NavigationViewControl_PaneOpening"
            PaneClosing="NavigationViewControl_PaneClosing"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            Header="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}"
            AutomationProperties.AutomationId="Hauptnavigation">

            <!-- Warum lokal überschrieben: Die Seitenleiste soll als eigenständige
                 Navigationsebene wahrgenommen werden, während der Inhaltsbereich weiterhin
                 Mica sowie das gewählte Hell-/Dunkel-Theme verwendet. -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#20273A" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#20273A" />
                <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#F7FBFC" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#16FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#24FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#30FFFFFF" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#AFA7FF" />
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <StackPanel x:Name="PaneMarkenbereich" Margin="12,8,12,12" Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="38" Height="38" CornerRadius="8" Background="#6D63D9">
                            <TextBlock Text="V" FontSize="20" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="VOKABELTRAINER" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock Text="Lernbegleiter" FontSize="11" Foreground="#B7BDD6" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#16FFFFFF" CornerRadius="7" Padding="11,9">
                        <StackPanel Spacing="2">
                            <TextBlock Text="LERNMODUS" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="50" Foreground="#9EA8D4" />
                            <TextBlock Text="Persönlicher Wortschatz" FontSize="13"
                                       Foreground="White" />
                            <TextBlock Text="{x:Bind ViewModel.LernspracheBezeichnung, Mode=OneWay}"
                                       FontSize="11" Foreground="#B7BDD6"
                                       AutomationProperties.AutomationId="AktiveLernsprache" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader x:Name="LernenUeberschrift">
                    <TextBlock Text="LERNEN" Margin="10,12,0,4" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="55" Foreground="#9EA8D4" />
                </NavigationViewItemHeader>
                <NavigationViewItem x:Name="TrainingNavigationItem" x:Uid="Shell_Main"
                                    Style="{StaticResource SeitenleistenEintrag}"
                                    helpers:NavigationHelper.NavigateTo="Vokabeltrainer.ViewModels.VokabelTrainingViewModel"
                                    AutomationProperties.AutomationId="NavigationTraining">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader x:Name="VerwaltungUeberschrift">
                    <TextBlock Text="VERWALTUNG" Margin="10,18,0,4" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="55" Foreground="#9EA8D4" />
                </NavigationViewItemHeader>
                <NavigationViewItem x:Name="VokabelNavigationItem" x:Uid="Shell_Vokabeleingabe"
                                    Style="{StaticResource SeitenleistenEintrag}"
                                    helpers:NavigationHelper.NavigateTo="Vokabeltrainer.ViewModels.VokabeleingabeViewModel"
                                    AutomationProperties.AutomationId="NavigationVokabeln">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE82D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="VerlaufNavigationItem" x:Uid="Shell_Sessions"
                                    Style="{StaticResource SeitenleistenEintrag}"
                                    helpers:NavigationHelper.NavigateTo="Vokabeltrainer.ViewModels.SessionsViewModel"
                                    AutomationProperties.AutomationId="NavigationVerlauf">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItemHeader x:Name="SystemUeberschrift">
                    <TextBlock Text="SYSTEM" Margin="10,8,0,4" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="55" Foreground="#9EA8D4" />
                </NavigationViewItemHeader>
                <NavigationViewItem x:Name="EinstellungenNavigationItem" Content="Einstellungen"
                                    Style="{StaticResource SeitenleistenEintrag}"
                                    helpers:NavigationHelper.NavigateTo="Vokabeltrainer.ViewModels.SettingsViewModel"
                                    AutomationProperties.AutomationId="NavigationEinstellungen">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Border x:Name="PaneStatusbereich" Margin="14,10,14,14" Padding="4,12,4,0"
                        BorderThickness="0,1,0,0" BorderBrush="#28FFFFFF">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#9EA8D4" />
                        <TextBlock Text="Daten lokal gespeichert" FontSize="11"
                                   Foreground="#B7BDD6" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{ThemeResource TitleTextBlockStyle}" />
                </DataTemplate>
            </NavigationView.HeaderTemplate>

            <i:Interaction.Behaviors>
                <behaviors:NavigationViewHeaderBehavior
                    DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                    <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{ThemeResource TitleTextBlockStyle}" />
                        </DataTemplate>
                    </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                </behaviors:NavigationViewHeaderBehavior>
            </i:Interaction.Behaviors>

            <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                <Frame x:Name="NavigationFrame" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
