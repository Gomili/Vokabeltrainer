<Page
    x:Class="Vokabeltrainer.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:Vokabeltrainer.Converter"
    xmlns:models="using:Vokabeltrainer.Core.Models"
    AutomationProperties.AutomationId="SitzungenSeite">

    <Page.Resources>
        <converter:DateTimeToTimeConverter x:Key="DateTimeToTimeConverter" />

        <Style x:Key="VerlaufKennzahlKarte" TargetType="Border">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinWidth" Value="112" />
        </Style>

        <Style x:Key="VerlaufAnzahlPlakette" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource FluentPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource FluentAccentCardStyle}"
                AutomationProperties.AutomationId="VerlaufZusammenfassung">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#20FFFFFF">
                        <FontIcon Glyph="&#xE81C;" FontSize="25"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Dein Lernverlauf" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Jede abgeschlossene Runde bringt dich deinem Lernziel näher."
                                   MaxWidth="360" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource VerlaufKennzahlKarte}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="EINHEITEN" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="55"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AnzahlSitzungen, Mode=OneWay}"
                                   Style="{StaticResource FluentMetricValueStyle}"
                                   AutomationProperties.AutomationId="VerlaufAnzahlSitzungen" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource VerlaufKennzahlKarte}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="GEÜBT" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="55"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GeuebteVokabeln, Mode=OneWay}"
                                   Style="{StaticResource FluentMetricValueStyle}"
                                   AutomationProperties.AutomationId="VerlaufGeuebteVokabeln" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource VerlaufKennzahlKarte}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TREFFERQUOTE" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="55"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.Trefferquote, Mode=OneWay}"
                                       Style="{StaticResource FluentMetricValueStyle}"
                                       AutomationProperties.AutomationId="VerlaufTrefferquote" />
                            <TextBlock Text="%" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Bottom" Margin="0,0,0,4"
                                       Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Abgeschlossene Lerneinheiten" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Die neuesten Trainings werden zuerst angezeigt."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource VerlaufAnzahlPlakette}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.AnzahlSitzungen, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.DisplayListe, Mode=OneWay}"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="SitzungenListe"
                          AutomationProperties.Name="Abgeschlossene Trainingssitzungen">
                    <ListView.Header>
                        <Grid Padding="16,10,16,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Beginn" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Ende" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Dauer" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="Vokabeln" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="Richtig" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="Falsch" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Session">
                            <Grid MinHeight="48" Padding="16,4" ColumnSpacing="16"
                                  Background="Transparent"
                                  AutomationProperties.Name="Trainingssitzung">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind StartTime, Converter={StaticResource DateTimeToTimeConverter}, ConverterParameter=DatumZeit}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind StopTime, Converter={StaticResource DateTimeToTimeConverter}, ConverterParameter=DatumZeit}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Zeit, Converter={StaticResource DateTimeToTimeConverter}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Anzahl}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind Richtige}"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE711;" FontSize="12"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="{x:Bind Falsche}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
