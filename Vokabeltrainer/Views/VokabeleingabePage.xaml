<Page
    x:Class="Vokabeltrainer.Views.VokabeleingabePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Vokabeltrainer.Core.Models"
    x:Name="EingabePage"
    AutomationProperties.AutomationId="VokabeleingabeSeite">

    <Page.Resources>
        <Style x:Key="HeroAnzahlKarte" TargetType="Border">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="MinWidth" Value="130" />
        </Style>

        <Style x:Key="AnzahlPlakette" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource FluentPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource FluentAccentCardStyle}"
                AutomationProperties.AutomationId="VokabelAnzahlKarte">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#20FFFFFF">
                        <FontIcon Glyph="&#xE82D;" FontSize="25"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Dein Wortschatz" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Vokabeln verwalten, priorisieren und für das nächste Training vorbereiten."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource HeroAnzahlKarte}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="GESPEICHERT" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AnzahlVokabeln, Mode=OneWay}"
                                   Style="{StaticResource FluentMetricValueStyle}"
                                   AutomationProperties.AutomationId="VokabelAnzahl" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Warum: Bearbeitung und Suche sind getrennte Aufgaben. Die Suche steht im
             Kopf des Editors, während die sprachlichen Felder als Einheit gruppiert bleiben. -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Vokabel bearbeiten" Style="{StaticResource FluentSectionTitleStyle}" />
                        <TextBlock Text="Wähle unten einen Eintrag aus oder lege eine neue Vokabel an."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             PlaceholderText="Wort oder Übersetzung suchen"
                             Text="{x:Bind ViewModel.SuchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsSpellCheckEnabled="False" MaxLength="256"
                             VerticalAlignment="Center"
                             AutomationProperties.AutomationId="VokabelSuche">
                        <TextBox.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="12" />
                                <TextBlock Text="Wortschatz durchsuchen" />
                            </StackPanel>
                        </TextBox.Header>
                    </TextBox>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Deutsch" PlaceholderText="Deutsches Wort"
                             Text="{x:Bind ViewModel.TextDeutsch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.HatAusgewaehlteVokabel, Mode=OneWay}"
                             IsSpellCheckEnabled="False" MaxLength="256"
                             AutomationProperties.AutomationId="DeutschEingabe" />
                    <TextBox Grid.Column="1" Header="Englisch" PlaceholderText="Englische Übersetzung"
                             Text="{x:Bind ViewModel.TextEnglisch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.HatAusgewaehlteVokabel, Mode=OneWay}"
                             IsSpellCheckEnabled="False" MaxLength="256"
                             AutomationProperties.AutomationId="EnglischEingabe" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="VokabelAktionen">
                        <Button Height="40" Click="NeueVokabel_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="NeueVokabel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="Neu" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Height="40" Command="{x:Bind ViewModel.VokabelSpeichernCommand}"
                                IsEnabled="{x:Bind ViewModel.HatAusgewaehlteVokabel, Mode=OneWay}"
                                AutomationProperties.AutomationId="VokabelSpeichern">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Save" />
                                <TextBlock Text="Speichern" />
                            </StackPanel>
                        </Button>
                        <Button Width="40" Height="40" Padding="0"
                                Command="{x:Bind ViewModel.VokabelLoeschenCommand}"
                                IsEnabled="{x:Bind ViewModel.HatAusgewaehlteVokabel, Mode=OneWay}"
                                Style="{StaticResource FluentDangerButtonStyle}"
                                ToolTipService.ToolTip="Ausgewählte Vokabel löschen"
                                AutomationProperties.Name="Ausgewählte Vokabel löschen"
                                AutomationProperties.AutomationId="VokabelLoeschen">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Vokabelliste" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Markierte Begriffe werden bei priorisierten Trainings bevorzugt."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource AnzahlPlakette}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.DisplayListe.Count, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ListView Grid.Row="1" x:Name="VokabelListe"
                          ItemsSource="{x:Bind ViewModel.DisplayListe, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedVokabel, Mode=TwoWay}"
                          SelectionChanged="VokabelListe_SelectionChanged"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="VokabelListe"
                          AutomationProperties.Name="Gespeicherte Vokabeln">
                    <ListView.Header>
                        <Grid Padding="16,10,16,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Priorität" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Deutsch" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="Englisch" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="Lernwert" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Vokabel">
                            <Grid MinHeight="44" Padding="16,4" ColumnSpacing="16"
                                  Background="Transparent"
                                  AutomationProperties.Name="{x:Bind Deutsch}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsMarked, Mode=TwoWay}"
                                          Command="{Binding ElementName=EingabePage, Path=ViewModel.SwitchMarkedCommand}"
                                          CommandParameter="{x:Bind}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          AutomationProperties.Name="Vokabel priorisieren" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Deutsch}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Englisch}" VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Zaehler}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
