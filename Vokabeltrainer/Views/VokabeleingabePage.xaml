<Page
    x:Class="Vokabeltrainer.Views.VokabeleingabePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Vokabeltrainer.Core.Models"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Margin="8,0,0,0" Text="Deutsch:" VerticalAlignment="Center"/>
            <TextBox Margin="8,0,0,0" Text="{x:Bind ViewModel.TextDeutsch, Mode=TwoWay}" Width="180"/>
            <TextBlock Margin="8,0,0,0" Text="Englisch:" VerticalAlignment="Center"/>
            <TextBox Margin="8,0,0,0" Text="{x:Bind ViewModel.TextEnglisch, Mode=TwoWay}" Width="180"/>
            <TextBlock Margin="8,0,0,0" Text="Zähler:" VerticalAlignment="Center"/>
            <TextBox Margin="8,0,0,0" Text="{x:Bind ViewModel.Zaehler, Mode=TwoWay}" Width="80"/>
        </StackPanel>
        <CommandBar Grid.Row="1" Margin="8" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" HorizontalAlignment="Left" >
            <AppBarButton Icon="Add" Label="Neu"/>
            <AppBarButton Icon="Save" Label="Speichern"/>
            <AppBarButton Icon="Delete" Label="Löschen" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
        </CommandBar>
        <!--<ListView x:Name="DataTable" ItemsSource="{x:Bind ViewModel.DisplayListe, Mode=OneWay}" Margin="4" ItemContainerStyle="{ThemeResource DataTableItem}"
                  ScrollViewer.HorizontalScrollMode="Auto" 
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.IsHorizontalRailEnabled="True">
            
        </ListView> -->
    </Grid> 
</Page>
