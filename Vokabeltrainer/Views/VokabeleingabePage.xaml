<Page
    x:Class="Vokabeltrainer.Views.VokabeleingabePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:display="using:Vokabeltrainer.DisplayClasses"
    xmlns:models="using:Vokabeltrainer.Core.Models"
    x:Name="EingabePage"
    AutomationProperties.AutomationId="VokabeleingabeSeite">

    <Page.Resources>
        <Style x:Key="HeroAnzahlKarte" TargetType="Border">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="MinWidth" Value="130" />
        </Style>

        <Style x:Key="AnzahlPlakette" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
        </Style>

        <Style x:Key="TagesgruppenEintragStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource FluentPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource FluentAccentCardStyle}"
                AutomationProperties.AutomationId="VokabelAnzahlKarte">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#20FFFFFF">
                        <FontIcon Glyph="&#xE82D;" FontSize="25"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Dein Wortschatz" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Vokabeln verwalten, priorisieren und für das nächste Training vorbereiten."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Border Style="{StaticResource HeroAnzahlKarte}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="GESPEICHERT" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60"
                                       Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AnzahlVokabeln, Mode=OneWay}"
                                       Style="{StaticResource FluentMetricValueStyle}"
                                       AutomationProperties.AutomationId="VokabelAnzahl" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HeroAnzahlKarte}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="PRIORISIERT" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="60"
                                       Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AnzahlPriorisierteVokabeln, Mode=OneWay}"
                                       Style="{StaticResource FluentMetricValueStyle}"
                                       AutomationProperties.AutomationId="PriorisierteVokabelAnzahl" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Warum: Bearbeitung und Suche sind getrennte Aufgaben. Die Suche steht im
             Kopf des Editors, während die sprachlichen Felder als Einheit gruppiert bleiben. -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Vokabel bearbeiten" Style="{StaticResource FluentSectionTitleStyle}" />
                        <TextBlock Text="Wähle unten einen Eintrag aus oder lege eine neue Vokabel an."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             PlaceholderText="Wort oder Übersetzung suchen"
                             Text="{x:Bind ViewModel.SuchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsSpellCheckEnabled="False" MaxLength="256"
                             VerticalAlignment="Center"
                             AutomationProperties.AutomationId="VokabelSuche">
                        <TextBox.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="12" />
                                <TextBlock Text="Wortschatz durchsuchen" />
                            </StackPanel>
                        </TextBox.Header>
                    </TextBox>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Deutsch" PlaceholderText="Deutsches Wort"
                             Text="{x:Bind ViewModel.TextDeutsch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.HatAusgewaehlteVokabel, Mode=OneWay}"
                             IsSpellCheckEnabled="False" MaxLength="256"
                             AutomationProperties.AutomationId="DeutschEingabe" />
                    <TextBox Grid.Column="1" Header="Englisch" PlaceholderText="Englische Übersetzung"
                             Text="{x:Bind ViewModel.TextEnglisch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.HatAusgewaehlteVokabel, Mode=OneWay}"
                             IsSpellCheckEnabled="False" MaxLength="256"
                             AutomationProperties.AutomationId="EnglischEingabe" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="VokabelAktionen">
                        <Button Height="40" Click="NeueVokabel_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="NeueVokabel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="Neu" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Height="40" Command="{x:Bind ViewModel.VokabelSpeichernCommand}"
                                IsEnabled="{x:Bind ViewModel.HatAusgewaehlteVokabel, Mode=OneWay}"
                                AutomationProperties.AutomationId="VokabelSpeichern">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Save" />
                                <TextBlock Text="Speichern" />
                            </StackPanel>
                        </Button>
                        <Button Width="40" Height="40" Padding="0"
                                Command="{x:Bind ViewModel.VokabelLoeschenCommand}"
                                IsEnabled="{x:Bind ViewModel.HatAusgewaehlteVokabel, Mode=OneWay}"
                                Style="{StaticResource FluentDangerButtonStyle}"
                                ToolTipService.ToolTip="Ausgewählte Vokabel löschen"
                                AutomationProperties.Name="Ausgewählte Vokabel löschen"
                                AutomationProperties.AutomationId="VokabelLoeschen">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Warum: Das Datum gilt als Vorgabe für mehrere anschließend erfasste
                     Vokabeln einer Lektion und bleibt deshalb außerhalb des Einzeldialogs sichtbar. -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Left">
                    <CheckBox Content="Neue Vokabeln später freigeben"
                              IsChecked="{x:Bind ViewModel.FreigabedatumFestlegen, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="Ohne Auswahl sind neue Vokabeln ab dem Eingabetag verfügbar."
                              AutomationProperties.AutomationId="FreigabedatumAktivieren" />

                    <DatePicker Date="{x:Bind ViewModel.FreigabedatumNeueVokabeln, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.FreigabedatumFestlegen, Mode=OneWay}"
                                MinWidth="190"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Erster Tag, an dem die neuen Vokabeln im Training erscheinen"
                                AutomationProperties.Name="Im Training verfügbar ab"
                                AutomationProperties.AutomationId="FreigabedatumNeueVokabeln" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="20,16,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Lektionen nach Lerntag" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Klappe einen Tag auf, um die Vokabeln dieser Unterrichtseinheit zu sehen."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource AnzahlPlakette}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.DisplayListe.Count, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Warum: Der Tag ist die fachliche Einheit einer Lektion. Ein Expander hält lange
                     Wortschätze übersichtlich, ohne Auswahl und Tabellenfunktionen zu verstecken. -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.TagesGruppen, Mode=OneWay}"
                          SelectionMode="None"
                          ItemContainerStyle="{StaticResource TagesgruppenEintragStyle}"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="VokabelListe"
                          AutomationProperties.Name="Vokabeln nach Lerntag">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="display:VokabelTagesgruppe">
                            <Expander Margin="8,4,8,8"
                                      IsExpanded="{x:Bind IstAufgeklappt, Mode=TwoWay}"
                                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                      CornerRadius="8"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      AutomationProperties.AutomationId="{x:Bind AutomatisierungsId}"
                                      AutomationProperties.Name="{x:Bind Automatisierungsname}">
                                <Expander.Header>
                                    <Grid MinHeight="58" Padding="4,4,12,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE787;" FontSize="17"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DatumsText}" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{x:Bind EinordnungsText}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource AnzahlPlakette}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind AnzahlText}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Expander.Header>

                                <ListView ItemsSource="{x:Bind Vokabeln}"
                                          SelectedItem="{Binding ElementName=EingabePage, Path=ViewModel.SelectedVokabel, Mode=TwoWay}"
                                          SelectionChanged="VokabelListe_SelectionChanged"
                                          HorizontalContentAlignment="Stretch"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.AutomationId="{x:Bind ListenAutomatisierungsId}"
                                          AutomationProperties.Name="{x:Bind Automatisierungsname}">
                                    <ListView.Header>
                                        <Grid Padding="16,10,16,8" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Priorität" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="Deutsch" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="Englisch" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="Lernwert" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </ListView.Header>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Vokabel">
                                            <Grid MinHeight="44" Padding="16,4" ColumnSpacing="16"
                                                  Background="Transparent"
                                                  AutomationProperties.Name="{x:Bind Deutsch}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{x:Bind IsMarked, Mode=OneWay}"
                                                          Tag="{x:Bind}"
                                                          Click="Priorisierung_Click"
                                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                                          AutomationProperties.Name="Vokabel priorisieren" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Deutsch}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Englisch}" VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Zaehler}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
