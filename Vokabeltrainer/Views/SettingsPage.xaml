<Page
    x:Class="Vokabeltrainer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Vokabeltrainer.Helpers"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    AutomationProperties.AutomationId="EinstellungenSeite">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

        <Style x:Key="EinstellungsSymbolKreis" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource FluentPageScrollViewerStyle}">
        <StackPanel Spacing="16">
            <Border Style="{StaticResource FluentAccentCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="28" Background="#20FFFFFF">
                        <FontIcon Glyph="&#xE713;" FontSize="25"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Deine App, deine Einstellungen"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Verwalte Sicherungen, Lernprioritäten und das Erscheinungsbild."
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Warum zweispaltig: Die fachlich unabhängigen Bereiche bleiben visuell
                 getrennt und nutzen auf Desktop-Fenstern die verfügbare Breite sinnvoll. -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.ColumnSpan="2" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource EinstellungsSymbolKreis}">
                            <FontIcon Glyph="&#xE8C1;" FontSize="18" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Lernsprache" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Eingabe, Training, Historie und Sicherungen verwenden diese Sprache."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{x:Bind ViewModel.Lernsprachen}"
                                  SelectedItem="{x:Bind ViewModel.AusgewaehlteLernsprache, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="LernspracheAuswahl" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Persönlich" Style="{StaticResource FluentSectionTitleStyle}" />
                            <TextBlock Text="Passe deinen Lernbegleiter an und verwalte deine gesammelten Wortfunken."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource EinstellungsSymbolKreis}">
                                <FontIcon Glyph="&#xE77B;" FontSize="18" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Dein Name" FontWeight="SemiBold" />
                                <TextBlock Text="Der Name wird in deinem Lernmenü angezeigt."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Text="{x:Bind ViewModel.Benutzername, Mode=TwoWay}"
                                     MaxLength="40" PlaceholderText="Name eingeben"
                                     AutomationProperties.AutomationId="BenutzernameEingabe" />
                            <Button Grid.Column="3" Content="Speichern"
                                    Command="{x:Bind ViewModel.BenutzernameSpeichernCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.AutomationId="BenutzernameSpeichern" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource EinstellungsSymbolKreis}">
                                <FontIcon Glyph="&#xE734;" FontSize="18"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Wortfunken" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{x:Bind ViewModel.Wortfunken, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="WortfunkenStand" />
                                    <TextBlock Text="Wortfunken gesammelt · entspricht aktuell"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.WortfunkenBetrag, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="WortfunkenBetrag" />
                                </StackPanel>
                                <ToggleSwitch Header="Neue Vokabeln belohnen"
                                              IsOn="{x:Bind ViewModel.BelohneNeueVokabeln, Mode=TwoWay}"
                                              OnContent="Ein" OffContent="Aus"
                                              AutomationProperties.AutomationId="BelohnungNeueVokabeln" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Auf 0 setzen"
                                    Click="WortfunkenZuruecksetzen_Click"
                                    Style="{StaticResource FluentDangerButtonStyle}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WortfunkenZuruecksetzen" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Datensicherung" Style="{StaticResource FluentSectionTitleStyle}" />
                            <TextBlock Text="Schütze deinen Wortschatz oder übertrage ihn auf ein anderes Gerät."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource EinstellungsSymbolKreis}">
                                <FontIcon Glyph="&#xE898;" FontSize="18" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Vokabeln exportieren" FontWeight="SemiBold" />
                                <TextBlock Text="Erstellt eine Sicherungsdatei für die ausgewählte Lernsprache."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Exportieren"
                                    Command="{x:Bind ViewModel.ExportCommand}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="VokabelnExportieren" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource EinstellungsSymbolKreis}">
                                <FontIcon Glyph="&#xE896;" FontSize="18" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Sicherung importieren" FontWeight="SemiBold" />
                                <TextBlock Text="Fügt Vokabeln zur ausgewählten Lernsprache hinzu."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Importieren"
                                    Command="{x:Bind ViewModel.ImportCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="VokabelnImportieren" />
                        </Grid>

                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ProgressBarVisibility, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Import wird verarbeitet" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ProgressVal, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Grid>
                            <ProgressBar Value="{x:Bind ViewModel.ProgressVal, Mode=OneWay}"
                                         Minimum="0" Maximum="{x:Bind ViewModel.ProgressMax, Mode=OneWay}"
                                         AutomationProperties.AutomationId="ImportFortschritt" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Darstellung" Style="{StaticResource FluentSectionTitleStyle}" />
                            <TextBlock Text="Wähle das Farbschema, das für dich angenehm ist."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8" AutomationProperties.AutomationId="FarbschemaAuswahl">
                            <RadioButton Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                         IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}"
                                         GroupName="AppTheme" HorizontalAlignment="Stretch"
                                         AutomationProperties.AutomationId="FarbschemaHell">
                                <RadioButton.CommandParameter><xaml:ElementTheme>Light</xaml:ElementTheme></RadioButton.CommandParameter>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE706;" FontSize="16" />
                                    <StackPanel>
                                        <TextBlock Text="Hell" FontWeight="SemiBold" />
                                        <TextBlock Text="Helle Flächen und dunkle Schrift" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                         IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}"
                                         GroupName="AppTheme" HorizontalAlignment="Stretch"
                                         AutomationProperties.AutomationId="FarbschemaDunkel">
                                <RadioButton.CommandParameter><xaml:ElementTheme>Dark</xaml:ElementTheme></RadioButton.CommandParameter>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE708;" FontSize="16" />
                                    <StackPanel>
                                        <TextBlock Text="Dunkel" FontWeight="SemiBold" />
                                        <TextBlock Text="Dunkle Flächen für eine ruhigere Darstellung" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Command="{x:Bind ViewModel.SwitchThemeCommand}"
                                         IsChecked="{x:Bind ViewModel.ElementTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Default, Mode=OneWay}"
                                         GroupName="AppTheme" HorizontalAlignment="Stretch"
                                         AutomationProperties.AutomationId="FarbschemaSystem">
                                <RadioButton.CommandParameter><xaml:ElementTheme>Default</xaml:ElementTheme></RadioButton.CommandParameter>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE770;" FontSize="16" />
                                    <StackPanel>
                                        <TextBlock Text="Systemeinstellung" FontWeight="SemiBold" />
                                        <TextBlock Text="Übernimmt automatisch die Windows-Einstellung" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource EinstellungsSymbolKreis}">
                            <FontIcon Glyph="&#xE74D;" FontSize="18"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Priorisierungen zurücksetzen" FontSize="17" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{x:Bind ViewModel.Markierte, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="AnzahlPriorisierungen" />
                                <TextBlock Text="Vokabeln sind aktuell priorisiert."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Zurücksetzen"
                                Command="{x:Bind ViewModel.LoeschenCommand}"
                                Style="{StaticResource FluentDangerButtonStyle}"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="PriorisierungenZuruecksetzen" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource FluentCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource EinstellungsSymbolKreis}">
                            <FontIcon Glyph="&#xE946;" FontSize="18" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Über diese App" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}"
                                       AutomationProperties.AutomationId="Versionsinformation" />
                            <TextBlock Text="Vokabeltrainer für regelmäßiges, fokussiertes Lernen."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
